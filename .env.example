# Local env for iris-mobile. Copy to .env and fill in.
# Values here are read via Constants.expoConfig.extra — see app.config.ts,
# which the Expo CLI evaluates with these vars auto-loaded from .env.
#
# Vercel web deploy: set these same variables under the Vercel project's
# Settings → Environment Variables (not this file — .env is git-ignored
# and never deployed).

# Backend API base URL. When running the API locally:
#   iOS simulator:      http://localhost:8080
#   Android emulator:   http://10.0.2.2:8080
#   Physical device:    http://<your-machine-lan-ip>:8080
# Vercel beta: iris-api isn't deployed yet — use a placeholder here until
# it goes live, then update the Vercel env var (no code change needed).
API_BASE_URL=http://localhost:8080

# Google OAuth client IDs from Google Cloud Console
# Set up per-platform OAuth 2.0 client IDs.
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
